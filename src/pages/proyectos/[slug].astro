---
/**
 * Página directa de cada proyecto (/proyectos/<slug>): la que se ve al recargar
 * o al entrar con el enlace. Misma experiencia que desde la home (cristal con
 * contraseña → pila 3D → columna), sin la transición de la esfera.
 */
import { PROYECTOS } from '../../data/proyectos';
import Archivo from '../../components/Archivo.astro';

export function getStaticPaths() {
  return PROYECTOS.map((proyecto) => ({ params: { slug: proyecto.slug }, props: { proyecto } }));
}

const { proyecto } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{proyecto.title.toLowerCase()} · capilladelacruz</title>
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body data-slug={proyecto.slug}>
    <Archivo backHref="/" title={proyecto.title} />
  </body>
</html>

<script>
  import { PROYECTOS } from '../../data/proyectos';
  import { Archivo } from '../../scripts/archivo/Archivo';

  const proyecto = PROYECTOS.find((p) => p.slug === document.body.dataset.slug);
  const root = document.querySelector<HTMLElement>('[data-archivo]');
  if (proyecto && root) {
    const archivo = new Archivo(root);
    archivo.abrir(proyecto);
    if (import.meta.env.DEV) {
      (window as any).__archivo = archivo; // depuración desde la consola
      Promise.all([import('lil-gui'), import('../../scripts/archivo/gui'), import('../../scripts/esferas/gui')]).then(
        ([{ default: GUI }, a, m]) => {
          const gui = new GUI({ title: 'Archivo · dev' });
          gui.domElement.style.zIndex = '50';
          a.addArchivoFolders(gui, archivo);
          m.addConfigFolder(gui); // al final: copiar CONFIG / guardar como defecto
        },
      );
    }
  }
</script>

<style>
  :global(html, body) {
    margin: 0;
    height: 100%;
    background: #fff;
    color: #000;
    overflow: hidden;
  }
  :global(body) {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
</style>
