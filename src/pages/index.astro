---
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>capilladelacruz</title>
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <video id="logo" src="/logo.mp4" muted playsinline preload="auto"></video>
    <audio id="musica" src="/musica.mp3" preload="auto"></audio>
    <button id="start">start</button>
    <button id="sonido">sonido on</button>
    <div id="flash"></div>
    <section id="final" lang="en">
      <div class="numero">
        <div id="countdown" role="timer" aria-label="seconds left"></div>
        <span class="unidad">seconds</span>
      </div>
      <div class="pie">
        <a class="cdlc-shine" href="https://www.instagram.com/capilladelacruz/" target="_blank" rel="noopener">CAPILLADELACRUZ</a>
      </div>
    </section>

    <script>
      const video = document.getElementById('logo') as HTMLVideoElement;
      const musica = document.getElementById('musica') as HTMLAudioElement;
      const start = document.getElementById('start')!;
      const sonido = document.getElementById('sonido')!;
      const flash = document.getElementById('flash')!;
      const final = document.getElementById('final')!;
      const countdown = document.getElementById('countdown')!;

      // Cuenta atrás: 20 dic 2026, 23:59 hora de Ginebra. Siempre desde Date.now().
      const TARGET = Date.parse('2026-12-20T23:59:00+01:00');
      let ultimoMinutoAria = -1;
      const restantes = () => Math.max(0, Math.floor((TARGET - Date.now()) / 1000));
      const agrupar = (n: number) => {
        const grupos = String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ').split(' ');
        return grupos.map((g, i) => (i ? `<span class="g">${g}</span>` : g)).join('');
      };
      const pintar = () => {
        const s = restantes();
        countdown.innerHTML = agrupar(s);
        const minuto = Math.floor(Date.now() / 60000);
        if (minuto !== ultimoMinutoAria || s === 0) {
          ultimoMinutoAria = minuto;
          countdown.setAttribute('aria-label', `${s} seconds left`);
        }
      };
      pintar();
      setTimeout(() => {
        pintar();
        setInterval(pintar, 1000);
      }, 1000 - (Date.now() % 1000));
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) pintar();
      });

      start.addEventListener('click', () => {
        video.play();
        musica.play();
        start.classList.add('fuera');
        video.classList.add('dentro');
        sonido.classList.add('dentro');
      });

      sonido.addEventListener('click', () => {
        musica.muted = !musica.muted;
        sonido.textContent = musica.muted ? 'sonido off' : 'sonido on';
      });

      video.addEventListener('ended', () => {
        flash.classList.add('on');
        sonido.classList.remove('dentro');

        const volumenInicial = musica.volume;
        let paso = 0;
        const fundido = setInterval(() => {
          paso++;
          musica.volume = Math.max(0, volumenInicial * (1 - paso / 15));
          if (paso >= 15) {
            clearInterval(fundido);
            musica.pause();
          }
        }, 100);

        setTimeout(() => {
          video.style.display = 'none';
          final.classList.add('dentro');
          flash.classList.remove('on');
        }, 1500);
      });
    </script>
  </body>
</html>

<style>
  :global(html, body) {
    margin: 0;
    height: 100%;
    background: #000;
    overflow: hidden;
  }
  :global(body) {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  button {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-transform: lowercase;
  }

  #logo {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s ease;
    z-index: 1;
  }
  #logo.dentro { opacity: 1; }

  #start {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
    font-size: 13px;
    letter-spacing: 0.35em;
    z-index: 2;
    animation: brillo 4s ease-in-out infinite;
    transition: opacity 0.6s ease;
  }
  #start.fuera { opacity: 0; pointer-events: none; animation: none; }

  #sonido {
    position: fixed;
    top: 24px;
    right: 24px;
    color: #fff;
    font-size: 11px;
    letter-spacing: 0.3em;
    z-index: 6;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  #sonido.dentro { opacity: 0.5; pointer-events: auto; }
  #sonido.dentro:hover { opacity: 1; }

  #flash {
    position: fixed;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.5s ease-in;
    z-index: 5;
  }
  #flash.on { opacity: 1; }

  #final {
    position: fixed;
    inset: 0;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    z-index: 4;
  }
  #final.dentro { opacity: 1; pointer-events: auto; }
  #final {
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    font-family: "Inter Tight", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  #countdown {
    color: #0a0a0a;
    font-weight: 200;
    font-size: min(4.5vw, 65px);
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  #countdown :global(.g) { margin-left: 0.22em; }
  .pie {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .numero { position: relative; }
  .unidad {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 20px;
    white-space: nowrap;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.45em;
    padding-left: 0.45em;
    color: #555555;
  }
  .pie a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.5em;
    margin-right: -0.5em;
    text-decoration: none;
  }
  @media (max-width: 599px) {
    #countdown { font-size: min(11vw, 48px); }
    .unidad { margin-top: 14px; }
  }
  .cdlc-shine{background:linear-gradient(100deg,#111 0%,#111 42%,#c8c8c8 50%,#111 58%,#111 100%);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:cdlcShine 3.5s ease-in-out infinite}
  .cdlc-shine:hover{animation-duration:1.2s}
  @keyframes cdlcShine{0%{background-position:100% 0}60%,100%{background-position:0% 0}}
  @media (prefers-reduced-motion: reduce){.cdlc-shine{animation:none;background:none;color:#111}}

  @keyframes brillo {
    0%, 100% { opacity: 0.2; text-shadow: none; }
    50% { opacity: 1; text-shadow: 0 0 8px rgba(255,255,255,0.7), 0 0 20px rgba(255,255,255,0.3); }
  }
</style>
