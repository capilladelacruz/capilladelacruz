---
/**
 * Esferas de partículas (una por proyecto) alrededor de "capilladelacruz",
 * en la página blanca final.
 * - Se prepara en segundo plano mientras se ve el botón "start".
 * - Empieza a animarse con el evento `capilla:final` (lo lanza index.astro).
 * - Al pulsar una esfera: sus partículas llenan la pantalla → archivo del proyecto
 *   (cristal con contraseña → pila 3D de fotos → columna).
 */
import { PROYECTOS } from '../data/proyectos';
import Archivo from './Archivo.astro';
---

<div id="esferas" class="esferas">
  <div class="esferas__canvas" data-canvas></div>
  <div class="esferas__veil" data-veil aria-hidden="true"></div>


  <nav class="esferas__a11y" data-buttons aria-label="Proyectos">
    {PROYECTOS.map((p) => (
      <button type="button" data-slug={p.slug} aria-label={p.title}>{p.title}</button>
    ))}
  </nav>

  <Archivo />
</div>

<script>
  import { PROYECTOS } from '../data/proyectos';
  import type { EsferasScene } from '../scripts/esferas/EsferasScene';
  import { Archivo, type ModoCandado } from '../scripts/archivo/Archivo';

  const root = document.getElementById('esferas')!;
  const final = document.getElementById('final');
  const title = final?.querySelector<HTMLElement>(':scope > a') ?? document.createElement('span');
  const archivoRoot = root.querySelector<HTMLElement>('[data-archivo]')!;
  const volver = archivoRoot.querySelector<HTMLButtonElement>('[data-volver]')!;
  const archivo = new Archivo(archivoRoot);

  let scene: EsferasScene | null = null;
  let preparing: Promise<EsferasScene | null> | null = null;
  let started = false;

  /** Carga Three.js y crea la escena (sin renderizar todavía). */
  function prepare() {
    preparing ??= import('../scripts/esferas/EsferasScene')
      .then(({ EsferasScene, CONFIG }) => {
        scene = new EsferasScene({
          root,
          canvasHost: root.querySelector('[data-canvas]')!,
          buttons: root.querySelector('[data-buttons]')!,
          veil: root.querySelector('[data-veil]')!,
          title,
          proyectos: PROYECTOS,
          onSelect: (p) => abrir(p.slug),
        });
        if (import.meta.env.DEV) (window as any).__esferas = { scene, CONFIG }; // depuración desde la consola
        return scene;
      })
      .catch((err) => {
        console.error('[esferas] WebGL no disponible', err);
        root.classList.add('sin-webgl');
        return null;
      });
    return preparing;
  }

  async function start() {
    if (started) return;
    started = true;
    root.classList.add('activo');
    const s = await prepare();
    s?.start();
    // Panel lil-gui: solo en desarrollo y solo en la página final.
    if (s && import.meta.env.DEV) {
      Promise.all([import('../scripts/esferas/gui'), import('../scripts/archivo/gui')]).then(([m, a]) => {
        const gui = m.initGui(s);
        a.addArchivoFolders(gui, archivo, { abrirPrueba: (modo) => abrir(PROYECTOS[0].slug, { modo }) });
        m.addConfigFolder(gui); // al final: copiar CONFIG / guardar como defecto
      });
    }
  }

  async function abrir(slug: string, { push = true, modo }: { push?: boolean; modo?: ModoCandado } = {}) {
    const proyecto = PROYECTOS.find((p) => p.slug === slug);
    if (!proyecto || !scene || scene.state !== 'idle') return;

    // Three.js y las fotos se cargan mientras la esfera se expande.
    archivo.precargar(proyecto);
    await scene.enter(slug);
    if (push) history.pushState({ proyecto: slug }, '', `/proyectos/${slug}`);
    if (scene.state !== 'inside') return;
    // Cristal con contraseña (solo la primera vez en la visita) → pila → columna.
    archivo.abrir(proyecto, modo);
  }

  async function cerrar() {
    if (!scene || scene.state !== 'inside') return;
    const slug = archivo.actual?.slug ?? null;
    await archivo.cerrar();
    await scene.exit();
    if (slug) root.querySelector<HTMLButtonElement>(`[data-buttons] [data-slug="${slug}"]`)?.focus({ preventScroll: true });
  }

  // "volver": si entramos con pushState, retrocede en el historial (popstate cierra).
  function salir() {
    if (history.state?.proyecto) history.back();
    else cerrar();
  }
  volver.addEventListener('click', salir);
  archivoRoot.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') salir();
  });
  window.addEventListener('popstate', (e) => {
    if (!started) return;
    const slug = e.state?.proyecto;
    if (slug) abrir(slug, { push: false });
    else cerrar();
  });

  // Atajo solo en local: /?skip salta la intro y va directo a las esferas.
  if (import.meta.env.DEV && new URLSearchParams(location.search).has('skip')) {
    document.getElementById('start')?.classList.add('fuera');
    const video = document.getElementById('logo');
    if (video) video.style.display = 'none';
    final?.classList.add('dentro');
  }

  // Prepara la escena en un momento tranquilo (pantalla del botón "start").
  const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 300));
  idle(() => prepare());

  if (final?.classList.contains('dentro')) start();
  else window.addEventListener('capilla:final', () => start(), { once: true });
</script>

<style>
  .esferas {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .esferas.activo {
    opacity: 1;
  }

  .esferas__canvas,
  .esferas__canvas :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .esferas__canvas {
    z-index: 0;
  }

  /* Velo que oscurece la pantalla en el punto máximo de la entrada */
  .esferas__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #000;
    opacity: 0;
    pointer-events: none;
  }

  /* Botones invisibles para teclado y lectores de pantalla */
  .esferas__a11y button {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* "capilladelacruz" se oculta mientras se entra en una esfera */
  :global(#final > a) {
    transition: color 0.5s ease;
  }
  :global(#final:has(.esferas.is-transitioning) > a) {
    color: transparent !important;
    pointer-events: none;
  }

</style>
